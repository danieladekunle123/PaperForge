{
  "name": "paperforge",
  "productName": "PaperForge",
  "version": "1.0.0",
  "description": "A local desktop PDF toolkit built around visual document assembly. Files stay on your computer.",
  "author": "PaperForge contributors",
  "license": "AGPL-3.0-or-later",
  "private": true,
  "type": "module",
  "main": "out/main/index.js",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "setup": "node scripts/setup-worker.mjs",
    "dev": "electron-vite dev",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "lint": "eslint . && node scripts/run-python.mjs -m ruff check worker",
    "test": "npm run test:unit && npm run test:worker && npm run test:e2e",
    "test:unit": "vitest run",
    "test:worker": "node scripts/run-python.mjs -m pytest worker/tests -q",
    "test:e2e": "electron-vite build && playwright test",
    "build": "npm run typecheck && npm run lint && electron-vite build && npm run build:worker && npm run build:win",
    "build:app": "electron-vite build",
    "build:worker": "node scripts/build-worker.mjs",
    "build:win": "electron-builder --win --x64 --publish never",
    "screenshots": "electron-vite build && node scripts/capture-screenshots.mjs",
    "notices": "node scripts/generate-notices.mjs",
    "test:packaged": "node scripts/test-packaged.mjs"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.64.1",
    "@tailwindcss/vite": "4.3.4",
    "@tanstack/react-virtual": "3.14.26",
    "@types/node": "24.9.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.2.1",
    "electron": "45.2.3",
    "electron-builder": "26.18.0",
    "electron-vite": "6.0.0",
    "eslint": "10.14.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "globals": "17.14.0",
    "lucide-react": "1.68.0",
    "pdfjs-dist": "6.5.438",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "tailwindcss": "4.3.4",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.1",
    "vite": "8.3.5",
    "vitest": "5.1.0",
    "zod": "4.6.7",
    "zustand": "5.0.16"
  }
}
